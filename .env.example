# Copy to .env and fill in. Never commit .env.

# Discord
DISCORD_TOKEN=your-bot-token-here
DISCORD_PREFIX=!
DISCORD_GUILD_ID=
# Shown in the bot's titles and status
SERVER_NAME=Game Server

# Optional: JSON file with the #role-select panel (see modules/role-select.js)
ROLE_SELECT_FILE=

# Optional: Student of the Week (see docs/student-of-the-week.md). Off unless true.
SOTW_ENABLED=false
# Channel IDs (Discord > Developer Mode > right-click a channel > Copy Channel ID)
SOTW_SUBMIT_CHANNEL=
SOTW_STAFF_CHANNEL=
SOTW_ANNOUNCE_CHANNEL=
# Optional archive channel
SOTW_HALL_CHANNEL=
# Time zone, weekday (0 = Monday ... 6 = Sunday) and hour (0-23) of the weekly pick
SOTW_TIMEZONE=America/Los_Angeles
SOTW_CYCLE_DAY=6
SOTW_CYCLE_HOUR=20
# Hours staff have to veto a pick before it goes live
SOTW_VETO_HOURS=12
SOTW_MIN_ACCOUNT_DAYS=14
SOTW_MIN_MEMBER_DAYS=3
SOTW_MAX_PER_WEEK=2
# Comma-separated sites entries may link to (blank = built-in list)
SOTW_LINK_HOSTS=
# Comma-separated words that are not allowed in entries
SOTW_BLOCKED_WORDS=
# Optional AI scoring (any OpenAI-compatible endpoint). Blank key = reactions only.
SOTW_AI_KEY=
SOTW_AI_URL=
SOTW_AI_MODEL=
SOTW_MODERATION_URL=
# Optional read-only web endpoint for the winner. Blank port = off.
SOTW_HTTP_HOST=127.0.0.1
SOTW_HTTP_PORT=
SOTW_PUBLIC_URL=
# Where winner.json, winner.txt and the entry file are kept
SOTW_DATA_DIR=data/sotw
